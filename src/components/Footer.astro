---
import { daysOld } from '@/lib/days';

const days = daysOld();
const year = new Date().getFullYear();
---

<footer
  class="mt-32 md:mt-48"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <hr class="hairline container-wide" style="margin-left: auto; margin-right: auto;" />
  <div class="container-wide py-16 md:py-24">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end">

      <div class="md:col-span-7 reveal">
        <p class="font-semibold leading-none tracking-tight tabular-nums"
           style="font-size: clamp(7rem, 18vw, 13rem);">
          {days}
        </p>
        <p class="mt-6 text-base text-ink-soft max-w-sm">
          白板出生了 {days} 天。<br />
          愿他每天都比昨天更勇敢一点。
        </p>
      </div>

      <div class="md:col-span-5 md:text-right text-ink-muted reveal" data-reveal-delay="160">
        <ul class="space-y-1.5 text-sm">
          <li>© {year} 白板的成长日记</li>
          <li>Border Collie</li>
          <li>Born 2026.09.10</li>
          <li>Home 2026.10.08</li>
        </ul>
      </div>

    </div>
  </div>
</footer>