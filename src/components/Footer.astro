---
import { daysOld } from '@/lib/days';

const days = daysOld();
const year = new Date().getFullYear();
---

<footer
  class="mt-32 md:mt-40 border-t border-line"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="container-wide py-12 md:py-16 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">

    <!-- 大字计数器 -->
    <div class="md:col-span-7 reveal">
      <p class="meta-label mb-4">Today</p>
      <p class="font-semibold text-5xl md:text-6xl text-ink leading-none tabular-nums tracking-tight">
        {days}
        <span class="text-2xl md:text-3xl text-ink-muted font-normal ml-2">天</span>
      </p>
      <p class="mt-4 text-body text-ink-soft max-w-sm">
        白板出生了 {days} 天。<br />
        愿他每天都比昨天更勇敢一点。
      </p>
    </div>

    <!-- 元信息 -->
    <div class="md:col-span-5 md:text-right text-ink-muted max-w-prose reveal reveal-d-2">
      <p class="meta-label mb-4">Colophon</p>
      <ul class="space-y-1 text-small">
        <li>© {year} 白板的成长日记</li>
        <li>Border Collie · 黑白 · 公</li>
        <li>Born 2026.09.10 · Home 2026.10.08</li>
        <li>
          <a
            href="/about/"
            class="link-underline text-ink-soft hover:text-ink"
          >
            关于
          </a>
        </li>
      </ul>
    </div>

  </div>
</footer>