---
import PhotoPlate from './PhotoPlate.astro';
import VideoPlate from './VideoPlate.astro';
import {
  formatChineseDate,
  dayNumber,
  type DayData,
  type PhotoMeta,
  type VideoMeta,
} from '@/lib/days';

export interface Props {
  date: string;
  meta: DayData;
  photos: Array<PhotoMeta & { caption: string; cover: boolean }>;
  videos?: Array<VideoMeta & { caption: string }>;
  /** 1-based spread index */
  spreadIndex: number;
  totalSpreads: number;
}

const {
  date,
  meta,
  photos,
  videos = [],
  spreadIndex,
  totalSpreads,
} = Astro.props;

const dayN = dayNumber(date);
const dateLabel = formatChineseDate(date);
---

<article class="mb-32 md:mb-48 pt-12 md:pt-24" data-spread data-date={date}>

  <!-- Spread head: one line, no folio -->
  <header class="container-plate mb-10 md:mb-16 reveal">
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-5">
      <p class="text-sm md:text-base text-ink-soft tabular-nums">
        {dateLabel}
      </p>
      <p class="text-sm md:text-base text-ink-muted tabular-nums">
        第 {dayN} 天 / 共 {totalSpreads} 天
      </p>
    </div>
  </header>

  <div class="space-y-4 md:space-y-6 stagger">

    {photos.length > 0 && (
      <div class="reveal-scale">
        <PhotoPlate
          src={photos[0].src}
          srcset={photos[0].srcset}
          alt={`白板. ${dateLabel}`}
          aspectRatio={photos[0].aspectRatio}
          onClick={true}
          forceEager={true}
        />
      </div>
    )}

    {photos.length > 1 && (
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
        {photos.slice(1).map((p, i) => (
          <div>
            <PhotoPlate
              src={p.src}
              srcset={p.srcset}
              alt={`白板. ${dateLabel}`}
              aspectRatio={p.aspectRatio}
              onClick={true}
              forceEager={i < 2}
            />
          </div>
        ))}
      </div>
    )}

    {videos.length > 0 && (
      <div class="grid grid-cols-2 gap-4 md:gap-6">
        {videos.map((v) => (
          <div>
            <VideoPlate
              videoSrc={v.video}
              posterSrc={v.poster}
              alt={`白板. ${dateLabel}`}
            />
          </div>
        ))}
      </div>
    )}

  </div>

</article>