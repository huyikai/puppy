---
import PhotoCard from './PhotoCard.astro';
import VideoCard from './VideoCard.astro';
import {
  formatChineseDate,
  moodToEmoji,
  dayNumber,
  type DayData,
  type PhotoMeta,
  type VideoMeta,
} from '@/lib/days';

export interface Props {
  date: string;
  meta: DayData;
  photos: Array<PhotoMeta & { caption: string; cover: boolean }>;
  videos?: Array<VideoMeta & { caption: string }>;
}

const { date, meta, photos, videos = [] } = Astro.props;

const dayN = dayNumber(date);
const dateLabel = formatChineseDate(date);
// ISO 简版：YYYY.MM.DD
const dateISO = date.replace(/-/g, '.');
---

<article class="mb-24 md:mb-40" data-day-card data-date={date}>

  <!-- Day 头部 -->
  <header class="mb-10 md:mb-14 reveal">
    <div class="flex items-center gap-3 mb-3 meta-label">
      <span>{dateISO}</span>
      <span class="text-line">/</span>
      <span>Day {dayN}</span>
      {meta.mood && (
        <>
          <span class="text-line">/</span>
          <span class="flex items-center gap-1.5">
            {moodToEmoji(meta.mood)} {meta.mood}
          </span>
        </>
      )}
    </div>
    <h2 class="font-semibold text-3xl md:text-4xl text-ink leading-tight tracking-tight">
      {meta.title || dateLabel}
    </h2>
    {meta.weather && (
      <p class="mt-3 text-small text-ink-muted">
        天气 · {meta.weather}
      </p>
    )}
  </header>

<!-- 照片流 -->
      {photos.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {photos.map((p, i) => {
            const isFirst = i === 0;
            const forceEager = i < 2;
            return (
              <div
                class:list={[
                  isFirst ? 'md:col-span-2' : '',
                  isFirst ? 'reveal' : 'reveal reveal-d-' + Math.min(i, 6),
                ]}
              >
                <PhotoCard
                  src={p.src}
                  srcset={p.srcset}
                  alt={`白板 · ${dateLabel} · 第${i + 1}张`}
                  aspectRatio={p.aspectRatio}
                  layout={isFirst ? 'full' : 'half'}
                  onClick={true}
                  index={i + 1}
                  caption={p.caption || undefined}
                  reveal={false}
                  forceEager={forceEager}
                />
              </div>
            );
          })}
        </div>
      )}

  <!-- 视频 -->
  {videos.length > 0 && (
    <div class="mt-12 md:mt-16">
      <h3 class="meta-label mb-6">Videos</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {videos.map((v, i) => (
          <div class="reveal reveal-d-2">
            <VideoCard
              videoSrc={v.video}
              posterSrc={v.poster}
              alt={`白板 · 视频 ${i + 1}`}
              index={photos.length + i + 1}
              reveal={false}
            />
          </div>
        ))}
      </div>
    </div>
  )}

</article>