---
import PhotoCard from './PhotoCard.astro';
import VideoCard from './VideoCard.astro';
import {
  formatChineseDate,
  moodToEmoji,
  dayNumber,
  type DayData,
  type PhotoMeta,
  type VideoMeta,
} from '@/lib/days';

export interface Props {
  date: string;
  meta: DayData;
  photos: Array<PhotoMeta & { caption: string; cover: boolean }>;
  videos?: Array<VideoMeta & { caption: string }>;
}

const { date, meta, photos, videos = [] } = Astro.props;

const dayN = dayNumber(date);
const dateLabel = formatChineseDate(date);
---

<article class="mb-32 md:mb-48" data-day-card data-date={date}>

  <!-- Day header: HUGE date as display type, no eyebrow -->
  <header class="container-wide mb-10 md:mb-16 reveal">
    <div class="grid grid-cols-12 gap-x-6 items-end">
      <time
        class="col-span-12 md:col-span-9 font-semibold text-ink leading-none tracking-tight tabular-nums"
        style="font-size: clamp(4.5rem, 14vw, 11rem);"
      >
        {date.replace(/-/g, '.')}
      </time>
      <div class="col-span-12 md:col-span-3 md:text-right mt-4 md:mt-0 pb-2">
        <p class="text-sm text-ink-muted">
          Day {dayN}
        </p>
        {meta.mood && (
          <p class="mt-1 text-sm text-ink-soft flex md:justify-end items-center gap-1.5">
            <span>{moodToEmoji(meta.mood)}</span>
            <span class="text-ink-muted">/</span>
            <span>{meta.mood}</span>
          </p>
        )}
      </div>
    </div>
    {meta.title && (
      <h2 class="mt-8 md:mt-10 font-semibold text-2xl md:text-4xl text-ink leading-tight tracking-tight max-w-bleed">
        {meta.title}
      </h2>
    )}
    {meta.note && (
      <p class="mt-5 md:mt-6 text-base md:text-lg text-ink-soft leading-relaxed max-w-prose">
        {meta.note}
      </p>
    )}
  </header>

  <!-- Photos:
       - Photo 0: FULL-BLEED wide (edge to edge, no margin)
       - Photos 1+: 3-column grid (varying aspect ratios break the rigidity) -->
  {photos.length > 0 && (
    <div class="space-y-3 md:space-y-4 stagger">

      <div class="reveal-scale">
        <PhotoCard
          src={photos[0].src}
          srcset={photos[0].srcset}
          alt={`白板. ${dateLabel}. 第1张`}
          aspectRatio={photos[0].aspectRatio}
          layout="wide"
          onClick={true}
          caption={photos[0].caption || undefined}
          forceEager={true}
        />
      </div>

      {photos.length > 1 && (
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
          {photos.slice(1).map((p, i) => (
            <PhotoCard
              src={p.src}
              srcset={p.srcset}
              alt={`白板. ${dateLabel}. 第${i + 2}张`}
              aspectRatio={p.aspectRatio}
              layout="grid"
              onClick={true}
              forceEager={i < 2}
            />
          ))}
        </div>
      )}

    </div>
  )}

  <!-- Videos as a final row (no "Videos" eyebrow) -->
  {videos.length > 0 && (
    <div class="mt-3 md:mt-4 grid grid-cols-2 gap-3 md:gap-4 stagger">
      {videos.map((v) => (
        <VideoCard
          videoSrc={v.video}
          posterSrc={v.poster}
          alt={`白板. 视频`}
        />
      ))}
    </div>
  )}

</article>