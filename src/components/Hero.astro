---
import { HERO_IMAGE, daysSinceHomecoming } from '@/lib/days';

const days = daysSinceHomecoming();
---

<section
  class="relative w-full overflow-hidden isolate"
  style="height: 78vh; min-height: 520px;"
  data-hero
>
  <!-- 背景图（视差层） -->
  <div
    class="absolute inset-0 -z-10 will-change-transform"
    data-hero-bg
  >
    <img
      src={HERO_IMAGE.src}
      srcset={HERO_IMAGE.srcset}
      sizes={HERO_IMAGE.sizes}
      alt={HERO_IMAGE.alt}
      class="w-full h-full object-cover object-center animate-fade-in"
      style="animation-duration: 1200ms;"
      loading="eager"
      fetchpriority="high"
    />
    <!-- 暖色渐变让白字在浅色图片上更可读 -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/15 to-black/55"></div>
  </div>

  <!-- 文字内容 -->
  <div class="absolute inset-x-0 bottom-0 z-10 pb-10 md:pb-14">
    <div class="container-wide text-white">
      <p class="meta-label text-white/85 mb-3 animate-fade-in-up">
        Border Collie · Day {days}
      </p>
      <h1
        class="font-semibold text-4xl md:text-5xl lg:text-6xl leading-[1.05] drop-shadow animate-fade-in-up"
        style="animation-delay: 100ms;"
      >
        白板的成长日记
      </h1>
      <p
        class="mt-3 md:mt-5 text-base md:text-lg text-white/85 max-w-md leading-relaxed animate-fade-in-up"
        style="animation-delay: 220ms;"
      >
        一只边牧，慢慢长大的样子。
      </p>
    </div>
  </div>
</section>

<script>
  // Hero 视差 — 幅度加大
  const heroes = document.querySelectorAll('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    let ticking = false;

    function update() {
        heroes.forEach((hero) => {
          const bg = hero.querySelector('[data-hero-bg]') as HTMLElement | null;
          if (!bg) return;
          const rect = hero.getBoundingClientRect();
          const vh = window.innerHeight;
          if (rect.bottom > 0 && rect.top < vh) {
            // 进度 -1..1
            const progress = (rect.top - vh * 0.5) / (vh * 0.5);
            // 上限 ±80px（比之前 40 大一倍）
            const translate = Math.max(-80, Math.min(80, -progress * 80));
            bg.style.transform = `translate3d(0, ${translate}px, 0) scale(1.12)`;
          }
        });
        ticking = false;
      }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    update();
  }
</script>