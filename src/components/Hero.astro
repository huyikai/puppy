---
import { HERO_IMAGE, daysSinceHomecoming } from '@/lib/days';

const days = daysSinceHomecoming();
---

<section
  class="relative w-full overflow-hidden isolate"
  style="height: 82vh; min-height: 560px;"
  data-hero
>
  <!-- Background image (parallax target) -->
  <div class="absolute inset-0 -z-10 will-change-transform" data-hero-bg>
    <img
      src={HERO_IMAGE.src}
      srcset={HERO_IMAGE.srcset}
      sizes={HERO_IMAGE.sizes}
      alt={HERO_IMAGE.alt}
      class="w-full h-full object-cover object-center animate-fade-in"
      style="animation-duration: 1200ms;"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Subtle bottom scrim for legibility -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/10 to-black/55"></div>
  </div>

  <!-- Text overlay: bottom-left, max 3 elements -->
  <div class="absolute inset-x-0 bottom-0 z-10 pb-12 md:pb-16">
    <div class="container-wide text-white">
      <p
        class="text-sm md:text-base text-white/85 leading-relaxed max-w-md animate-fade-in-up"
        style="animation-delay: 100ms;"
      >
        一只边牧，慢慢长大的样子。
      </p>
      <h1
        class="mt-3 md:mt-4 font-semibold leading-[1.05] drop-shadow animate-fade-in-up"
        style="font-size: clamp(3rem, 8vw, 5.5rem); animation-delay: 220ms;"
      >
        白板的成长日记
      </h1>
      <p
        class="mt-5 md:mt-6 text-sm md:text-base text-white/80 max-w-md leading-relaxed animate-fade-in-up"
        style="animation-delay: 340ms;"
      >
        到家第 {days} 天
      </p>
    </div>
  </div>
</section>

<script>
  // Hero parallax (skill 5.D: never use window.scroll listener for animation)
  const heroes = document.querySelectorAll('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    let ticking = false;

    function update() {
      heroes.forEach((hero) => {
        const bg = hero.querySelector('[data-hero-bg]') as HTMLElement | null;
        if (!bg) return;
        const rect = hero.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.bottom > 0 && rect.top < vh) {
          const progress = (rect.top - vh * 0.5) / (vh * 0.5);
          const translate = Math.max(-90, Math.min(90, -progress * 90));
          bg.style.transform = `translate3d(0, ${translate}px, 0) scale(1.14)`;
        }
      });
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    update();
  }
</script>