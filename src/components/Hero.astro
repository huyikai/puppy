---
import { HERO_IMAGE, daysSinceHomecoming } from '@/lib/days';

const days = daysSinceHomecoming();
---

<section
  class="relative w-full overflow-hidden"
  style="height: 70vh; min-height: 480px;"
  data-hero
>
  <!-- 背景图（视差层） -->
  <div
    class="absolute inset-0 -z-10 will-change-transform"
    data-hero-bg
  >
    <img
      src={HERO_IMAGE.src}
      srcset={HERO_IMAGE.srcset}
      sizes={HERO_IMAGE.sizes}
      alt={HERO_IMAGE.alt}
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- 底部暖色渐变，让白字在浅色图片上更可读 -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/10 to-black/30"></div>
  </div>

  <!-- 文字内容 -->
  <div class="absolute inset-x-0 bottom-0 z-10 pb-12 md:pb-16">
    <div class="container-content text-white">
      <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-white/80 mb-3 animate-fade-in-up">
        Border Collie · {days >= 1 ? `Day ${days}` : ''}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl lg:text-5xl font-medium leading-[1.15] drop-shadow-sm animate-fade-in-up"
          style="animation-delay: 80ms;">
        白板的成长日记
      </h1>
      <p class="mt-3 md:mt-4 text-sm md:text-base text-white/85 max-w-md animate-fade-in-up"
         style="animation-delay: 160ms;">
        一只边牧，慢慢长大的样子。
      </p>
    </div>
  </div>
</section>

<script>
  // 简易视差：滚动时背景图轻微上移
  const heroes = document.querySelectorAll('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    let ticking = false;

    function update() {
      heroes.forEach((hero) => {
        const bg = hero.querySelector('[data-hero-bg]') as HTMLElement | null;
        if (!bg) return;
        const rect = hero.getBoundingClientRect();
        const vh = window.innerHeight;
        // 当 hero 在视口内时计算偏移
        if (rect.bottom > 0 && rect.top < vh) {
          // 进度 0~1：完全滚出时为 -1，刚刚滚入时为 1
          const progress = (rect.top - vh * 0.5) / (vh * 0.5);
          // 上限 ±40px
          const translate = Math.max(-40, Math.min(40, -progress * 40));
          bg.style.transform = `translate3d(0, ${translate}px, 0) scale(1.08)`;
        }
      });
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );

    // 初始执行一次
    update();
  }
</script>