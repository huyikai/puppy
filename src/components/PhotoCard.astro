---
export interface Props {
  src: string;
  srcset?: string;
  alt?: string;
  /** "wide" = full-bleed (edge to edge); "grid" = inside 3-col grid */
  layout?: 'wide' | 'grid';
  /** Click to open lightbox */
  onClick?: boolean;
  /** File index for caption (sparse use) */
  index?: number;
  /** Custom caption */
  caption?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'auto' | 'high' | 'low';
  aspectRatio?: number;
  /** Force eager (for above-fold images) */
  forceEager?: boolean;
}

const {
  src,
  srcset,
  alt = '',
  layout = 'grid',
  onClick = false,
  caption,
  index,
  loading = 'lazy',
  fetchpriority = 'auto',
  aspectRatio = 1,
  forceEager = false,
} = Astro.props;

const sizes =
  layout === 'wide'
    ? '100vw'
    : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<figure class="group">
  <div
    class="relative overflow-hidden bg-bg-elevated"
    style={`aspect-ratio: ${aspectRatio};`}
    data-photo={onClick ? 'clickable' : undefined}
    data-photo-src={onClick ? src : undefined}
    data-photo-srcset={onClick ? srcset : undefined}
    data-photo-alt={onClick ? alt : undefined}
    data-photo-caption={onClick ? (caption || alt) : undefined}
    role={onClick ? 'button' : undefined}
    tabindex={onClick ? 0 : undefined}
    aria-label={onClick ? `查看图片：${alt}` : undefined}
  >
    <img
      src={src}
      srcset={srcset}
      sizes={sizes}
      alt={alt}
      loading={forceEager ? 'eager' : loading}
      fetchpriority={forceEager ? 'high' : fetchpriority}
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover
             transition-transform duration-x-slow ease-expo
             group-hover:scale-[1.04]"
    />
  </div>

  {(caption || index !== undefined) && layout === 'wide' && (
    <figcaption class="mt-4 text-sm text-ink-muted max-w-prose">
      {caption}
    </figcaption>
  )}
</figure>