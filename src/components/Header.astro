---
export interface Props {
  isHome?: boolean;
  current?: string;
}

const { isHome = false, current } = Astro.props;
---

<header
  class="sticky top-0 z-40 bg-bg/85 backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top);"
  data-header
>
  <div class="container-wide h-14 md:h-16 flex items-center justify-between gap-4">

    <a
      href="/"
      class="font-semibold text-base md:text-lg text-ink tracking-tight"
      data-header-home-link
    >
      白板
      <span class="text-ink-muted font-normal hidden sm:inline">
        · 白板的成长日记
      </span>
    </a>

    <nav class="flex items-center gap-5 md:gap-7">
      {!isHome && (
        <a
          href="/"
          class="text-sm text-ink-soft hover:text-ink transition-colors duration-base"
        >
          首页
        </a>
      )}
      <a
        href="/about/"
        class="text-sm text-ink-soft hover:text-ink transition-colors duration-base"
      >
        关于
      </a>
    </nav>

  </div>

  {current && (
    <div class="border-t border-line">
      <div class="container-wide h-10 flex items-center">
        <span class="meta-label">{current}</span>
      </div>
    </div>
  )}
</header>