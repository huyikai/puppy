---
export interface Props {
  /** Current location in the book */
  at?: 'cover' | 'spreads' | 'colophon';
}

const { at = 'cover' } = Astro.props;
---

<header
  class="absolute top-0 left-0 right-0 z-30"
  style="padding-top: env(safe-area-inset-top);"
>
  <div class="container-plate">
    <div class="h-14 md:h-16 flex items-center justify-between text-sm">
      <a
        href="/"
        class="font-medium tracking-tight text-ink hover:text-accent transition-colors duration-base"
      >
        白板
      </a>

      <nav class="flex items-center gap-6 md:gap-8 text-ink-soft">
        <a
          href="/"
          class:list={[
              at === 'cover' ? 'text-ink' : '',
              'hover:text-ink transition-colors duration-base',
            ]}
          aria-current={at === 'cover' ? 'page' : undefined}
        >
          记录
        </a>
        <a
          href="/about/"
          class:list={[
              at === 'colophon' ? 'text-ink' : '',
              'hover:text-ink transition-colors duration-base',
            ]}
          aria-current={at === 'colophon' ? 'page' : undefined}
        >
          关于
        </a>
      </nav>
    </div>
  </div>
</header>