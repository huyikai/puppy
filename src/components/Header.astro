---
export interface Props {
  at?: 'cover' | 'spreads' | 'colophon';
}

const { at = 'cover' } = Astro.props;
---

<header
  class="absolute top-0 left-0 right-0 z-30"
  style="padding-top: env(safe-area-inset-top);"
>
  <div class="container-plate">
    <!-- Centered nav, no logo on the left -->
    <nav class="h-14 md:h-16 flex items-center justify-center gap-8 md:gap-12 text-sm">
      <a
        href="/"
        class:list={[
          'relative py-1 transition-colors duration-base',
          at === 'cover' ? 'text-ink' : 'text-ink-soft hover:text-ink',
        ]}
        aria-current={at === 'cover' ? 'page' : undefined}
      >
        记录
        {at === 'cover' && (
          <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full" style="background-color: var(--accent);"></span>
        )}
      </a>
      <a
        href="/about/"
        class:list={[
          'relative py-1 transition-colors duration-base',
          at === 'colophon' ? 'text-ink' : 'text-ink-soft hover:text-ink',
        ]}
        aria-current={at === 'colophon' ? 'page' : undefined}
      >
        关于
        {at === 'colophon' && (
          <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full" style="background-color: var(--accent);"></span>
        )}
      </a>
    </nav>
  </div>
</header>