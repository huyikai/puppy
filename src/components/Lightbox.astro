---
/* Lightbox: image preview on dark scrim. Global, one instance per page. */
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-bg-scrim backdrop-blur-2xl"
  role="dialog"
  aria-modal="true"
  aria-label="图片预览"
  data-lightbox
>
  <button
    type="button"
    class="absolute top-4 right-4 md:top-6 md:right-6 z-10 w-11 h-11 flex items-center justify-center text-white transition-all duration-base hover:rotate-90"
    aria-label="关闭"
    data-lightbox-close
  >
    <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>

  <button
    type="button"
    class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 flex items-center justify-center text-white transition-all duration-base hover:scale-110"
    aria-label="上一张"
    data-lightbox-prev
  >
    <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <button
    type="button"
    class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 flex items-center justify-center text-white transition-all duration-base hover:scale-110"
    aria-label="下一张"
    data-lightbox-next
  >
    <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="max-w-[92vw] max-h-[88vh] reveal-scale is-visible" data-lightbox-img-wrap>
    <img
      src=""
      alt=""
      class="max-w-[92vw] max-h-[88vh] object-contain select-none"
      data-lightbox-img
      draggable="false"
    />
  </div>

  <div class="absolute bottom-4 md:bottom-6 inset-x-0 z-10 flex flex-col items-center gap-1 px-4 pointer-events-none">
    <p class="text-sm text-white/85 max-w-prose text-center" data-lightbox-caption></p>
    <p class="text-xs text-white/55 tabular-nums" data-lightbox-counter></p>
  </div>
</div>

<script>
  type LightboxItem = {
    src: string;
    srcset?: string;
    alt?: string;
    caption?: string;
  };

  const root = document.querySelector('[data-lightbox]') as HTMLElement | null;
  if (root) {
    const imgWrap = root.querySelector('[data-lightbox-img-wrap]') as HTMLElement;
    const imgEl = root.querySelector('[data-lightbox-img]') as HTMLImageElement;
    const counterEl = root.querySelector('[data-lightbox-counter]') as HTMLElement;
    const captionEl = root.querySelector('[data-lightbox-caption]') as HTMLElement;
    const closeBtn = root.querySelector('[data-lightbox-close]') as HTMLButtonElement;
    const prevBtn = root.querySelector('[data-lightbox-prev]') as HTMLButtonElement;
    const nextBtn = root.querySelector('[data-lightbox-next]') as HTMLButtonElement;

    let items: LightboxItem[] = [];
    let current = 0;

    function show(i: number) {
      if (i < 0) i = items.length - 1;
      if (i >= items.length) i = 0;
      current = i;
      const it = items[i];
      imgWrap.classList.remove('is-visible');
      requestAnimationFrame(() => {
        imgEl.srcset = it.srcset || '';
        imgEl.src = it.src;
        imgEl.alt = it.alt || '';
        captionEl.textContent = it.caption || '';
        counterEl.textContent = `${i + 1} / ${items.length}`;
        requestAnimationFrame(() => imgWrap.classList.add('is-visible'));
      });
    }

    function open(newItems: LightboxItem[], startIndex = 0) {
      items = newItems;
      show(startIndex);
      root!.classList.remove('hidden');
      root!.classList.add('flex');
      document.body.classList.add('lightbox-open');
    }

    function close() {
      root!.classList.add('hidden');
      root!.classList.remove('flex');
      document.body.classList.remove('lightbox-open');
    }

    function next() { show(current + 1); }
    function prev() { show(current - 1); }

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);
    root.addEventListener('click', (e) => { if (e.target === root) close(); });

    document.addEventListener('keydown', (e) => {
      if (root.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });

    function gather(): { items: LightboxItem[]; refMap: WeakMap<Element, number> } {
      const els = Array.from(document.querySelectorAll('[data-photo="clickable"]'));
      const refMap = new WeakMap<Element, number>();
      const list: LightboxItem[] = els.map((el, i) => {
        const src = (el as HTMLElement).dataset.photoSrc || '';
        const srcset = (el as HTMLElement).dataset.photoSrcset || '';
        const alt = (el as HTMLElement).dataset.photoAlt || '';
        const caption = (el as HTMLElement).dataset.photoCaption || '';
        refMap.set(el, i);
        return { src, srcset, alt, caption };
      });
      return { items: list, refMap };
    }

    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-photo="clickable"]') as HTMLElement | null;
      if (!target) return;
      const { items, refMap } = gather();
      const i = refMap.get(target);
      if (typeof i === 'number') {
        e.preventDefault();
        open(items, i);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const target = (e.target as HTMLElement).closest('[data-photo="clickable"]') as HTMLElement | null;
      if (!target) return;
      e.preventDefault();
      const { items, refMap } = gather();
      const i = refMap.get(target);
      if (typeof i === 'number') open(items, i);
    });
  }
</script>