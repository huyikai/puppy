---
import { daysOld } from '@/lib/days';

const daysAlive = daysOld();

// Cover portrait: AI-generated animated WebP based on白板's photos
const COVER_PORTRAIT = '/cover/cover-animated.webp';
---

{/*
  Cover page. Title page of the photo book.
  Centered composition: animated portrait + large title + small metadata.
  A scroll hint with a one-time page-bounce + text float animation.
*/}
<section
  class="min-h-screen flex items-center justify-center relative"
  data-cover
>
  <div class="container-content w-full max-w-4xl">

    <div class="flex flex-col items-center text-center reveal">

      <div class="reveal-scale">
        <img
          src={COVER_PORTRAIT}
          alt="白板"
          width="480"
          height="480"
          class="w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 object-cover plate"
          loading="eager"
        />
      </div>

      <h1
        class="mt-12 md:mt-16 font-medium text-ink tracking-tight leading-[1.05]"
        style="font-size: clamp(3rem, 9vw, 6rem);"
      >
        白板
      </h1>

      <p class="mt-6 md:mt-8 text-base md:text-lg text-ink-soft max-w-md leading-relaxed">
        今天已经 {daysAlive} 天大了
      </p>

      <p class="mt-4 text-sm text-ink-muted tabular-nums">
        2026 年 9 月 10 日出生
      </p>

      </div>

  </div>
</section>

<script>
  // Cover page: one-time bounce + click-to-scroll-past (no visible scroll cue).
  const cover = document.querySelector<HTMLElement>('[data-cover]');

  if (cover) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // -- One-time page bounce on first paint ----------------------------
    if (!reduceMotion && !sessionStorage.getItem('cover-bounced')) {
      sessionStorage.setItem('cover-bounced', '1');
      const target = Math.min(window.innerHeight * 0.55, 360);
      const start = performance.now();
      const dur = 1100;
      const tick = (now: number) => {
        const t = Math.min((now - start) / dur, 1);
        const eased = Math.sin(t * Math.PI);
        window.scrollTo({ top: target * eased, behavior: 'auto' });
        if (t < 1) requestAnimationFrame(tick);
      };
      window.setTimeout(() => requestAnimationFrame(tick), 700);
    }

    // -- Click anywhere on cover → smooth-scroll past -------------------
    cover.addEventListener('click', (e) => {
      const inner = (e.target as HTMLElement).closest('a, button');
      if (inner) return;
      const bottom = cover.getBoundingClientRect().bottom + window.scrollY;
      window.scrollTo({ top: bottom, behavior: 'smooth' });
    });
  }
</script>