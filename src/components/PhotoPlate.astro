---
export interface Props {
  src: string;
  srcset?: string;
  alt?: string;
  /** Click-to-open lightbox */
  onClick?: boolean;
  /** Loading behavior */
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'auto' | 'high' | 'low';
  aspectRatio?: number;
  /** Force eager (for above-fold) */
  forceEager?: boolean;
}

const {
  src,
  srcset,
  alt = '',
  onClick = false,
  loading = 'lazy',
  fetchpriority = 'auto',
  aspectRatio = 1,
  forceEager = false,
} = Astro.props;

const sizes = '(min-width: 1280px) 1200px, 100vw';
---

<div
  class="plate overflow-hidden"
  style={`aspect-ratio: ${aspectRatio};`}
  data-photo={onClick ? 'clickable' : undefined}
  data-photo-src={onClick ? src : undefined}
  data-photo-srcset={onClick ? srcset : undefined}
  data-photo-alt={onClick ? alt : undefined}
  data-photo-caption={onClick ? alt : undefined}
  role={onClick ? 'button' : undefined}
  tabindex={onClick ? 0 : undefined}
  aria-label={onClick ? `查看图片：${alt}` : undefined}
>
  <img
    src={src}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    loading={forceEager ? 'eager' : loading}
    fetchpriority={forceEager ? 'high' : fetchpriority}
    decoding="async"
    class="w-full h-full object-cover
           transition-transform duration-x-slow ease-expo
           group-hover:scale-[1.03]"
  />
</div>