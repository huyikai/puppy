---
export interface Props {
  videoSrc: string;
  posterSrc?: string | null;
  alt?: string;
  aspectRatio?: number;
}

const {
  videoSrc,
  posterSrc,
  alt = '',
  aspectRatio = 4 / 5,
} = Astro.props;
---

<figure
  class="plate overflow-hidden group relative"
  style={`aspect-ratio: ${aspectRatio};`}
  data-video-card
  data-video-src={videoSrc}
  data-video-poster={posterSrc}
>
  {posterSrc && (
    <img
      src={posterSrc}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover
             transition-transform duration-x-slow ease-expo
             group-hover:scale-[1.03]"
      data-video-poster
    />
  )}

  <video
    src={videoSrc}
    poster={posterSrc || undefined}
    preload="none"
    playsinline
    muted
    loop
    class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-base"
    data-video-preview
  ></video>

  <button
    type="button"
    class="absolute inset-0 z-10 flex items-center justify-center"
    aria-label="播放视频"
    data-video-play
  >
    <span
      class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white/95
             flex items-center justify-center
             transition-all duration-base ease-expo
             group-hover:scale-110 group-hover:bg-white
             shadow-[0_6px_24px_rgba(0,0,0,0.18)]"
    >
      <svg
        viewBox="0 0 24 24"
        class="w-5 h-5 md:w-6 md:h-6 text-ink ml-0.5"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>
</figure>

<script>
  document.querySelectorAll('[data-video-card]').forEach((card) => {
    const playBtn = card.querySelector('[data-video-play]') as HTMLButtonElement | null;
    const poster = card.querySelector('[data-video-poster]') as HTMLImageElement | null;
    const preview = card.querySelector('[data-video-preview]') as HTMLVideoElement | null;
    if (!playBtn || !preview) return;

    let hoverTimer: number | undefined;
    card.addEventListener('mouseenter', () => {
      hoverTimer = window.setTimeout(() => preview.play().catch(() => {}), 250);
    });
    card.addEventListener('mouseleave', () => {
      if (hoverTimer) clearTimeout(hoverTimer);
      preview.pause();
      preview.currentTime = 0;
      poster?.classList.remove('opacity-0');
      preview.classList.add('opacity-0');
    });

    card.addEventListener('pointerenter', () => preview.play().catch(() => {}));
    card.addEventListener('pointerleave', () => {
      preview.pause();
      preview.currentTime = 0;
      poster?.classList.remove('opacity-0');
      preview.classList.add('opacity-0');
    });

    playBtn.addEventListener('click', () => {
      preview.muted = false;
      preview.controls = true;
      preview.classList.remove('opacity-0');
      poster?.classList.add('opacity-0');
      preview.play().catch(() => {});
      const v = preview as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
      if (v.requestFullscreen) v.requestFullscreen();
      else if (v.webkitEnterFullscreen) v.webkitEnterFullscreen();
    });
  });
</script>