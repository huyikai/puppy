---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import BookCover from '@/components/BookCover.astro';
import Spread from '@/components/Spread.astro';
import Lightbox from '@/components/Lightbox.astro';

import {
  getAllDays,
  getManifest,
  resolvePhotos,
  resolveVideos,
  daysOld,
} from '@/lib/days';

const RECENT_DAYS = 30;
const allDays = await getAllDays();
const recentDays = allDays.slice(0, RECENT_DAYS);
const olderDays = allDays.slice(RECENT_DAYS);

const recentData = await Promise.all(
  recentDays.map(async (entry) => {
    const manifest = await getManifest(entry.data.date);
    const photos = resolvePhotos(entry.data.photos, manifest);
    const videos = resolveVideos(entry.data.videos, manifest);
    return { entry, photos, videos };
  }),
);

const daysAlive = daysOld();
const hasOlder = olderDays.length > 0;
---

<BaseLayout>
  <Header slot="header" at="cover" />

  <BookCover />

  <section class="container-wide py-16 md:py-24">

    {recentData.map(({ entry, photos, videos }, i) => (
      <Spread
        date={entry.data.date}
        meta={entry.data}
        photos={photos}
        videos={videos}
        spreadIndex={i + 1}
        totalSpreads={recentData.length}
      />
    ))}

    {hasOlder && (
      <div class="reveal mt-12 md:mt-20 text-center">
        <a
          href="/archive/"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-line text-ink text-sm hover:border-ink transition-colors duration-base"
        >
          查看更早的 {olderDays.length} 天
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    )}

  </section>

  <EndMark slot="footer" />
  <Lightbox />
</BaseLayout>