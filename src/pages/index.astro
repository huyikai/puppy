---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import DayCard from '@/components/DayCard.astro';
import Lightbox from '@/components/Lightbox.astro';

import {
  getAllDays,
  getManifest,
  resolvePhotos,
  resolveVideos,
  daysSinceHomecoming,
} from '@/lib/days';

const days = await getAllDays();

// 解析每天的 manifest
const daysData = await Promise.all(
  days.map(async (entry) => {
    const manifest = await getManifest(entry.data.date);
    const photos = resolvePhotos(entry.data.photos, manifest);
    const videos = resolveVideos(entry.data.videos, manifest);
    return { entry, photos, videos };
  }),
);

const daysAlive = daysSinceHomecoming();
---

<BaseLayout isHome={true}>
  <Header slot="header" isHome={true} />

  <Hero />

  <div class="container-content py-12 md:py-20">
    <div class="mb-10 md:mb-14 text-center max-w-prose mx-auto animate-fade-in-up">
      <p class="text-xs md:text-sm uppercase tracking-[0.25em] text-text-muted">
        Day {daysAlive} · 一日一记
      </p>
      <p class="mt-3 font-serif text-base md:text-xl text-text-body leading-relaxed">
        这是我家边牧白板的成长日记。<br class="hidden md:block" />
        从到家第一天起，慢慢地，把他的样子记下来。
      </p>
    </div>

    {daysData.length === 0 ? (
      <p class="text-center text-text-muted">还没有任何记录。</p>
    ) : (
      daysData.map(({ entry, photos, videos }) => (
        <DayCard
          date={entry.data.date}
          meta={entry.data}
          photos={photos}
          videos={videos}
        />
      ))
    )}
  </div>

  <Footer slot="footer" />
  <Lightbox />
</BaseLayout>