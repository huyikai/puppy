---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import BookCover from '@/components/BookCover.astro';
import Spread from '@/components/Spread.astro';
import Lightbox from '@/components/Lightbox.astro';

import {
  getAllDays,
  getManifest,
  resolvePhotos,
  resolveVideos,
} from '@/lib/days';

const days = await getAllDays();

const daysData = await Promise.all(
  days.map(async (entry) => {
    const manifest = await getManifest(entry.data.date);
    const photos = resolvePhotos(entry.data.photos, manifest);
    const videos = resolveVideos(entry.data.videos, manifest);
    return { entry, photos, videos };
  }),
);

const totalSpreads = daysData.length;
---

<BaseLayout>
  <Header slot="header" at="cover" />

  <BookCover />

  <!-- Spreads begin -->
  <section>
    {daysData.map(({ entry, photos, videos }, i) => (
      <Spread
        date={entry.data.date}
        meta={entry.data}
        photos={photos}
        videos={videos}
        spreadIndex={i + 1}
        totalSpreads={totalSpreads}
      />
    ))}
  </section>

  <EndMark slot="footer" />
  <Lightbox />
</BaseLayout>