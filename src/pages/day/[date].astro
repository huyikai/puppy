---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import Spread from '@/components/Spread.astro';
import Lightbox from '@/components/Lightbox.astro';

import {
  getAllDays,
  getDay,
  getManifest,
  resolvePhotos,
  resolveVideos,
  formatChineseDate,
  dayNumber,
} from '@/lib/days';

export async function getStaticPaths() {
  const days = await getAllDays();
  return days.map((d) => ({ params: { date: d.data.date } }));
}

const { date } = Astro.params;
const entry = await getDay(date!);

if (!entry) return Astro.redirect('/404/');

const manifest = await getManifest(date!);
const photos = resolvePhotos(entry.data.photos, manifest);
const videos = resolveVideos(entry.data.videos, manifest);

const allDays = await getAllDays();
const idx = allDays.findIndex((d) => d.data.date === date);
const prevDay = idx < allDays.length - 1 ? allDays[idx + 1] : null;
const nextDay = idx > 0 ? allDays[idx - 1] : null;
---

<BaseLayout
  title={`${formatChineseDate(date!)} Day ${dayNumber(date!)}`}
  description="白板的成长日记"
>
  <Header slot="header" at="spreads" />

  <Spread
    date={date!}
    meta={entry.data}
    photos={photos}
    videos={videos}
    spreadIndex={idx + 1}
    totalSpreads={allDays.length}
  />

  <!-- Prev / Next spread links -->
  <nav class="container-plate mt-16 md:mt-24 reveal">
    <hr class="hairline mb-10" />
    <div class="flex items-center justify-between text-sm pb-12">
      {prevDay ? (
        <a
          href={`/day/${prevDay.data.date}/`}
          class="link-underline text-ink-soft hover:text-ink inline-flex items-center gap-2"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {formatChineseDate(prevDay.data.date)}
        </a>
      ) : <span></span>}

      {nextDay ? (
        <a
          href={`/day/${nextDay.data.date}/`}
          class="link-underline text-ink-soft hover:text-ink inline-flex items-center gap-2"
        >
          {formatChineseDate(nextDay.data.date)}
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : <span></span>}
    </div>
  </nav>

  <EndMark slot="footer" />
  <Lightbox />
</BaseLayout>