---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
---

<BaseLayout title="这页走丢了" description="找不到这页。">
  <Header slot="header" />

  <section class="container-prose py-24 md:py-40 text-center">

    <div class="reveal">
      <h1
        class="font-medium text-ink tracking-tight leading-[1.0]"
        style="font-size: clamp(2.5rem, 8vw, 5.5rem);"
      >
        这页走丢了
      </h1>
      <p class="mt-6 text-base md:text-lg text-ink-soft leading-relaxed">
        白板歪了歪头，找了好几遍也没找到这一页。<br />
        可能是链接写错了，也可能是这一页还没被拍下来。
      </p>

      <div class="mt-12 flex items-center justify-center gap-3 flex-wrap">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-ink text-bg text-sm font-medium hover:bg-ink-soft transition-colors duration-base"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          回到封面
        </a>
        <a
          href="/about/"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-line text-ink text-sm transition-colors duration-base hover:border-ink"
        >
          关于
        </a>
      </div>
    </div>

  </section>

  <EndMark slot="footer" />
</BaseLayout>