---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import { AVATAR_IMAGE, BIRTHDAY, HOMECOMING_DATE, daysOld, formatChineseDate } from '@/lib/days';

const days = daysOld();
const birthdayLabel = formatChineseDate(BIRTHDAY);
const homeLabel = formatChineseDate(HOMECOMING_DATE);
---

<BaseLayout
  title="Colophon"
  description="白板的成长日记 / 编辑信息"
>
  <Header slot="header" at="colophon" />

  <article class="container-prose py-16 md:py-24">

    <!-- Title -->
    <header class="reveal">
      <p class="folio" style="color: var(--accent);">COLOPHON</p>
      <h1
        class="mt-6 font-medium text-ink tracking-tight leading-[1.0]"
        style="font-size: clamp(2.5rem, 8vw, 5.5rem);"
      >
        编辑信息
      </h1>
      <p class="mt-6 text-base md:text-lg text-ink-soft leading-relaxed">
        一本关于一只边牧的私人摄影记录。
      </p>
    </header>

    <hr class="hairline my-12 md:my-16" />

    <!-- Portrait + subject metadata -->
    <section class="reveal">
      <figure class="plate overflow-hidden aspect-square">
        <img
          src={AVATAR_IMAGE.src}
          srcset={AVATAR_IMAGE.srcset}
          sizes={AVATAR_IMAGE.sizes}
          alt={AVATAR_IMAGE.alt}
          width="800"
          height="800"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </figure>

      <dl class="mt-10 space-y-5 text-sm">
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Subject</dt>
          <dd class="col-span-2 text-ink">白板</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Breed</dt>
          <dd class="col-span-2 text-ink">Border Collie</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Sex</dt>
          <dd class="col-span-2 text-ink">公</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Colour</dt>
          <dd class="col-span-2 text-ink">黑白</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Born</dt>
          <dd class="col-span-2 text-ink tabular-nums">{birthdayLabel}</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">Home</dt>
          <dd class="col-span-2 text-ink tabular-nums">{homeLabel}</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 pt-3">
          <dt class="folio">Age</dt>
          <dd class="col-span-2 text-ink tabular-nums">{days} 天</dd>
        </div>
      </dl>
    </section>

    <hr class="hairline my-12 md:my-16" />

    <!-- Editorial essay -->
    <section class="reveal space-y-5 text-base md:text-lg text-ink-soft leading-relaxed">
      <p>
        这是我家边牧白板的成长日记。一个只为他一个人开的小角落。
      </p>
      <p>
        不想发朋友圈，也不想在社交媒体上表演养狗。这里只是把每天的样子记下来。他今天吃了什么，玩了什么，有什么新的表情。
      </p>
    </section>

    <hr class="hairline my-12 md:my-16" />

    <!-- Production notes -->
    <section class="reveal">
      <p class="folio mb-6">PRODUCTION</p>
      <dl class="space-y-3 text-sm">
        <div class="grid grid-cols-3 gap-4">
          <dt class="folio">Stack</dt>
          <dd class="col-span-2 text-ink-soft">Astro, Tailwind, ffmpeg</dd>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <dt class="folio">Host</dt>
          <dd class="col-span-2 text-ink-soft">Vercel</dd>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <dt class="folio">Source</dt>
          <dd class="col-span-2 text-ink-soft">
            <a
              href="https://github.com/huyikai/puppy"
              class="link-underline"
              rel="noopener"
            >
              github.com/huyikai/puppy
            </a>
          </dd>
        </div>
      </dl>
    </section>

    <!-- End marker -->
    <div class="mt-20 md:mt-28 text-center reveal">
      <hr class="hairline w-12 mx-auto" />
      <p class="folio mt-6" style="color: var(--accent);">END</p>
    </div>

  </article>

  <EndMark slot="footer" />
</BaseLayout>