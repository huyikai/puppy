---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import { AVATAR_IMAGE, BIRTHDAY, HOMECOMING_DATE, daysOld, formatChineseDate } from '@/lib/days';

const days = daysOld();
const birthdayLabel = formatChineseDate(BIRTHDAY);
const homeLabel = formatChineseDate(HOMECOMING_DATE);
---

<BaseLayout
  title="关于"
  description="白板的成长日记 / 关于"
>
  <Header slot="header" at="colophon" />

  <article class="container-prose py-16 md:py-24">

    <!-- Title -->
    <header class="reveal">
      <h1
        class="font-medium text-ink tracking-tight leading-[1.0]"
        style="font-size: clamp(2.5rem, 8vw, 5.5rem);"
      >
        关于
      </h1>
      <p class="mt-6 text-base md:text-lg text-ink-soft leading-relaxed">
        一本关于一只边牧的私人摄影记录。
      </p>
    </header>

    <hr class="hairline my-12 md:my-16" />

    <!-- Portrait + subject metadata -->
    <section class="reveal">
      <figure class="plate overflow-hidden aspect-square">
        <img
          src={AVATAR_IMAGE.src}
          srcset={AVATAR_IMAGE.srcset}
          sizes={AVATAR_IMAGE.sizes}
          alt={AVATAR_IMAGE.alt}
          width="800"
          height="800"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </figure>

      <dl class="mt-10 space-y-5 text-sm">
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">名字</dt>
          <dd class="col-span-2 text-ink">白板</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">品种</dt>
          <dd class="col-span-2 text-ink">Border Collie 边牧</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">性别</dt>
          <dd class="col-span-2 text-ink">公</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">毛色</dt>
          <dd class="col-span-2 text-ink">黑白</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">生日</dt>
          <dd class="col-span-2 text-ink tabular-nums">{birthdayLabel}</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 border-b border-line pb-3">
          <dt class="folio">到家</dt>
          <dd class="col-span-2 text-ink tabular-nums">{homeLabel}</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 pt-3">
          <dt class="folio">出生</dt>
          <dd class="col-span-2 text-ink tabular-nums">{days} 天</dd>
        </div>
      </dl>
    </section>

    <hr class="hairline my-12 md:my-16" />

    <!-- Editorial essay -->
    <section class="reveal space-y-5 text-base md:text-lg text-ink-soft leading-relaxed">
      <p>
        这是我家边牧白板的成长日记。一个只为他一个人开的小角落。
      </p>
      <p>
        不想发朋友圈，也不想在社交媒体上表演养狗。这里只是把每天的样子记下来。他今天吃了什么，玩了什么，有什么新的表情。
      </p>
    </section>

    <hr class="hairline my-12 md:my-16" />

  </article>

  <EndMark slot="footer" />
</BaseLayout>