---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { AVATAR_IMAGE, BIRTHDAY, HOMECOMING_DATE, daysOld, formatChineseDate } from '@/lib/days';

const days = daysOld();
const birthdayLabel = formatChineseDate(BIRTHDAY);
const homeLabel = formatChineseDate(HOMECOMING_DATE);
---

<BaseLayout
  title="关于白板"
  description="一只边牧，慢慢长大的样子。"
>
  <Header slot="header" current="关于" />

  <article class="container-wide pt-12 md:pt-20 pb-20">

    <!-- 标题 -->
    <header class="max-w-[920px] mx-auto mb-16 md:mb-24 reveal">
      <p class="meta-label mb-6">Colophon</p>
      <h1 class="font-semibold text-5xl md:text-6xl text-ink leading-[1.05] tracking-tight">
        关于白板
      </h1>
      <p class="mt-6 text-lg md:text-xl text-ink-soft leading-relaxed max-w-prose">
        边境牧羊犬。黑白。男孩。<br />
        2026 年 9 月 10 日出生，10 月 8 日来到我家。
      </p>
    </header>

    <!-- 主体：左大图 + 右元数据（杂志式编辑页） -->
    <section class="max-w-[920px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 mb-20 md:mb-28">

      <!-- 大头像 -->
      <div class="md:col-span-7 reveal">
        <img
          src={AVATAR_IMAGE.src}
          srcset={AVATAR_IMAGE.srcset}
          sizes={AVATAR_IMAGE.sizes}
          alt={AVATAR_IMAGE.alt}
          width="800"
          height="800"
          class="w-full h-auto"
          loading="eager"
        />
      </div>

      <!-- 元数据列 -->
      <aside class="md:col-span-5 reveal reveal-d-2">
        <dl class="space-y-5 text-base">
          <div>
            <dt class="meta-label mb-1">品种</dt>
            <dd class="text-ink">Border Collie</dd>
          </div>
          <div>
            <dt class="meta-label mb-1">性别</dt>
            <dd class="text-ink">公</dd>
          </div>
          <div>
            <dt class="meta-label mb-1">毛色</dt>
            <dd class="text-ink">黑白</dd>
          </div>
          <div>
            <dt class="meta-label mb-1">生日</dt>
            <dd class="text-ink tabular-nums">{birthdayLabel}</dd>
          </div>
          <div>
            <dt class="meta-label mb-1">到家</dt>
            <dd class="text-ink tabular-nums">{homeLabel}</dd>
          </div>
          <div class="pt-6 mt-6 border-t border-line">
            <dt class="meta-label mb-3">Today</dt>
            <dd class="text-ink">
              <span class="font-semibold text-4xl md:text-5xl tabular-nums tracking-tight">
                {days}
              </span>
              <span class="text-ink-muted text-base ml-2">天大了</span>
            </dd>
          </div>
        </dl>
      </aside>
    </section>

    <!-- 叙述 -->
    <section class="max-w-prose mx-auto space-y-8 reveal">
      <h2 class="font-semibold text-2xl md:text-3xl text-ink tracking-tight">
        这个站点
      </h2>
      <div class="space-y-5 text-base md:text-lg text-ink-soft leading-relaxed">
        <p>
          这是我家边牧白板的成长日记。一个只为他一个人开的小角落。
        </p>
        <p>
          不想发朋友圈，也不想在社交媒体上表演养狗。这里只是把每天的样子记下来——他今天吃了什么、玩了什么、有什么新的表情。
        </p>
        <p>
          站点用 Astro + Tailwind 手工搭建。每次新增素材丢进当日文件夹，推送到 GitHub，Vercel 自动部署上线。
        </p>
      </div>
    </section>

    <!-- 性格 -->
    <section class="max-w-prose mx-auto mt-20 md:mt-28 reveal">
      <h2 class="font-semibold text-2xl md:text-3xl text-ink mb-8 tracking-tight">
        小名 & 性格
      </h2>
      <dl class="space-y-6 text-base md:text-lg text-ink-soft leading-relaxed">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-6">
          <dt class="meta-label">小名</dt>
          <dd class="md:col-span-3">白板（黑白相间，名副其实）</dd>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-6">
          <dt class="meta-label">性格</dt>
          <dd class="md:col-span-3">好奇、有点怂、爱黏人</dd>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-6">
          <dt class="meta-label">喜欢</dt>
          <dd class="md:col-span-3">羊奶粉泡的狗粮、熊椅、被人摸头</dd>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-6">
          <dt class="meta-label">讨厌</dt>
          <dd class="md:col-span-3">被关在笼子里出不来（暂时）</dd>
        </div>
      </dl>
    </section>

  </article>

  <Footer slot="footer" />
</BaseLayout>