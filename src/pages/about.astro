---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import EndMark from '@/components/EndMark.astro';
import { AVATAR_IMAGE, BIRTHDAY, HOMECOMING_DATE, formatChineseDate } from '@/lib/days';

const birthdayLabel = formatChineseDate(BIRTHDAY);
const homeLabel = formatChineseDate(HOMECOMING_DATE);
---

<BaseLayout
  title="关于"
  description="白板的成长日记 / 关于"
>
  <Header slot="header" at="colophon" />

  <article class="container-prose py-20 md:py-32">

    <!-- 标题（居中） -->
    <header class="reveal text-center">
      <h1
        class="font-medium text-ink tracking-tight leading-[1.0]"
        style="font-size: clamp(2.5rem, 8vw, 5.5rem);"
      >
        关于
      </h1>
      <p class="mt-6 text-base md:text-lg text-ink-soft leading-relaxed">
        白板的成长日记。
      </p>
    </header>

    <!-- 头像（居中） -->
    <section class="reveal mt-20 md:mt-28 flex justify-center">
      <figure class="plate overflow-hidden aspect-square w-full max-w-md">
        <img
          src={AVATAR_IMAGE.src}
          srcset={AVATAR_IMAGE.srcset}
          sizes={AVATAR_IMAGE.sizes}
          alt={AVATAR_IMAGE.alt}
          width="800"
          height="800"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </figure>
    </section>

    <!-- 主人手记（居中） -->
    <section class="reveal mt-20 md:mt-28 text-center">
      <p class="text-2xl md:text-4xl text-ink font-light leading-[1.4] tracking-tight mx-auto max-w-md">
        每天给他拍拍照<br />
        看着他慢慢长大
      </p>
    </section>

    <!-- 事实 dl（一行 key-value 居中） -->
    <section class="reveal mt-20 md:mt-28">
      <dl class="text-sm space-y-4">
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">名字</dt>
          <dd class="text-ink">白板</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">品种</dt>
          <dd class="text-ink">边牧</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">性别</dt>
          <dd class="text-ink">公</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">毛色</dt>
          <dd class="text-ink">黑白</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">生日</dt>
          <dd class="text-ink tabular-nums">{birthdayLabel}</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-center gap-x-3">
          <dt class="folio">到家</dt>
          <dd class="text-ink tabular-nums">{homeLabel}</dd>
        </div>
      </dl>
    </section>

  </article>

  <EndMark slot="footer" />
</BaseLayout>

<script define:vars={{ BIRTHDAY }}>
  const start = new Date(BIRTHDAY + 'T00:00:00');
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const diffMs = today.getTime() - start.getTime();
  const days = Math.max(0, Math.floor(diffMs / (1000 * 60 * 60 * 24)));
  document.querySelectorAll('[data-days-old-about]').forEach((el) => {
    el.textContent = String(days);
  });
</script>